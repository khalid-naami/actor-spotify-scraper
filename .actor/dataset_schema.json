{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "id": {
        "type": "string",
        "description": "Spotify unique identifier"
      },
      "type": {
        "type": "string",
        "description": "Item type: track, artist, album, playlist, show, or episode"
      },
      "title": {
        "type": "string",
        "description": "Title or name of the item"
      },
      "url": {
        "type": "string",
        "description": "Direct Spotify URL"
      },
      "owner": {
        "type": "string",
        "description": "Playlist curator or show publisher"
      },
      "artists": {
        "type": "array",
        "description": "List of associated artists",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "album": {
        "type": "string",
        "description": "Album title if applicable"
      },
      "durationMs": {
        "type": "integer",
        "description": "Track duration in milliseconds"
      },
      "durationFormatted": {
        "type": "string",
        "description": "Track duration in mm:ss format"
      },
      "releaseDate": {
        "type": "string",
        "description": "Release date if available"
      },
      "monthlyListeners": {
        "type": "string",
        "description": "Monthly listener count for artist"
      },
      "followersCount": {
        "type": "string",
        "description": "Total followers or saves count"
      },
      "isVerified": {
        "type": "boolean",
        "description": "Verified Spotify artist badge"
      },
      "trackCount": {
        "type": "integer",
        "description": "Total track count in album or playlist"
      },
      "tracks": {
        "type": "array",
        "description": "List of tracks inside album or playlist",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "coverImageUrl": {
        "type": "string",
        "description": "High resolution cover artwork or avatar URL"
      },
      "audioUrl": {
        "type": "string",
        "description": "Preview audio URL if available"
      },
      "description": {
        "type": "string",
        "description": "Playlist, artist bio, or podcast description"
      },
      "searchKeyword": {
        "type": "string",
        "description": "Search query that matched this result"
      },
      "scrapedAt": {
        "type": "string",
        "description": "Extraction timestamp"
      }
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": [
          "type",
          "title",
          "owner",
          "trackCount",
          "followersCount",
          "monthlyListeners",
          "durationFormatted",
          "url"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "type": {
            "label": "Type",
            "format": "text"
          },
          "title": {
            "label": "Title",
            "format": "text"
          },
          "owner": {
            "label": "Curator / Owner",
            "format": "text"
          },
          "trackCount": {
            "label": "Tracks",
            "format": "number"
          },
          "followersCount": {
            "label": "Followers / Saves",
            "format": "text"
          },
          "monthlyListeners": {
            "label": "Monthly Listeners",
            "format": "text"
          },
          "durationFormatted": {
            "label": "Duration",
            "format": "text"
          },
          "url": {
            "label": "Spotify URL",
            "format": "link"
          }
        }
      }
    }
  }
}
